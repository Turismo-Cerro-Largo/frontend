{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.jj": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		".gitignore": true,
		".npmrc": true,
		"pnpm-lock.yaml": true,
		"pnpm-workspace.yaml": true,
		"README.md": true,
		"tsconfig.json": true,
		".env.example": true,
		".prettierignore": true,
		".svelte-kit": true,
		".vscode": true,
		"build": true,
		"node_modules": true
	},
	"hide-files.files": [
		".gitignore",
		".npmrc",
		"pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"README.md",
		"tsconfig.json",
		".env.example",
		".prettierignore",
		".svelte-kit",
		".vscode",
		"build",
		"node_modules"
	]
}
