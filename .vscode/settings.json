{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.jj": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"pnpm-workspace.yaml": true,
		"README.md": true,
		"tsconfig.json": true,
		".env.example": true,
		".prettierignore": true,
		".svelte-kit": true,
		"AGENTS.md": true,
		".vscode": true,
		"src/routes/radios-locales": true
	},
	"hide-files.files": [
		"pnpm-workspace.yaml",
		"README.md",
		"tsconfig.json",
		".env.example",
		".prettierignore",
		".svelte-kit",
		"AGENTS.md",
