{
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		".gitignore": true,
		".npmrc": true,
		"pnpm-lock.yaml": true,
		"pnpm-workspace.yaml": true,
		"README.md": true,
		"tsconfig.json": true
	},
	"hide-files.files": [
		".gitignore",
		".npmrc",
		"pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"README.md",
		"tsconfig.json"
	]
}
