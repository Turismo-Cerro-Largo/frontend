# Copiá este archivo a .env y completá los valores del proyecto.

# Backend. Usá su origen sin /api.
API_URL=http://localhost:4000
# En Vercel: API_URL=https://cerro-largo-api-cloud-2.baa4ts.workers.dev

# Mapa
PUBLIC_MAPBOX_TOKEN=

# Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=

# Opcional en producción: URL del proveedor de geocodificación compatible con Nominatim.
GEOCODING_REVERSE_URL=
