# Copiar a .env. Token PUBLICO de Mapbox (pk.), nunca secreto.
PUBLIC_MAPBOX_TOKEN=

# URL privada para SSR, sin /api. Configurar también en Vercel:
API_URL=https://cerro-largo-api.baa4ts.workers.dev
# Para desarrollar con backend local: API_URL=http://127.0.0.1:4000

# El navegador usa /api mediante vercel.json (producción) o Vite (desarrollo).
# Vercel no necesita ORIGIN ni BODY_SIZE_LIMIT de adapter-node.
# No agregar service_role ni claves privadas de Supabase en el frontend.
