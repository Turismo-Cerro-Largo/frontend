# Copiar a .env. Usar solo un token PUBLICO de Mapbox (pk.).
PUBLIC_MAPBOX_TOKEN=
PUBLIC_TURNSTILE_SITE_KEY=

# URL privada del backend, sin /api. El backend local escucha en 4000.
API_URL=http://localhost:4000

# Origen del frontend para adapter-node. Usar HTTPS al desplegar.
ORIGIN=http://localhost:5173
# Permite los formularios con imagenes; la API aplica sus propios limites.
BODY_SIZE_LIMIT=20M
